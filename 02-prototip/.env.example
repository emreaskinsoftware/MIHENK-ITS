# MİHENK — yapay zekâ sağlayıcı yapılandırması
#
# Bu dosyayı `.env.local` olarak kopyalayın ve anahtarınızı girin.
# HİÇBİR ANAHTAR TANIMLI DEĞİLSE sistem yerel çıkarımsal motora düşer
# ve prototip yine uçtan uca çalışır.
#
#   cp .env.example .env.local

# Hangi sağlayıcı kullanılsın: claude | openai | gemini
# Boş bırakılırsa tanımlı olan ilk anahtar otomatik seçilir.
YZ_SAGLAYICI=claude

# Model adını elle sabitlemek isterseniz (opsiyonel)
# YZ_MODEL=claude-sonnet-5

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
