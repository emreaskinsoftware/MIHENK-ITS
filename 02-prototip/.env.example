# MİHENK — yapay zekâ sağlayıcı yapılandırması
#
# Bu dosyayı `.env.local` olarak kopyalayın ve anahtarınızı girin:
#   cp .env.example .env.local
#
# HİÇBİR ANAHTAR TANIMLI DEĞİLSE sistem yerel çıkarımsal motora düşer
# ve prototip yine uçtan uca çalışır.

# claude | openai | azure | gemini
# Boş bırakılırsa tanımlı olan ilk anahtar otomatik seçilir.
YZ_SAGLAYICI=azure

# ---- Azure OpenAI (Azure for Students ile önerilen) ----
# Portal > Azure OpenAI kaynağı > "Keys and Endpoint"
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://KAYNAK-ADINIZ.openai.azure.com
# Azure AI Foundry'de oluşturduğunuz DAĞITIM adı (model adı değil!)
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# ---- Diğer sağlayıcılar ----
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Model adını elle sabitlemek için (opsiyonel, Azure dışı sağlayıcılarda)
# YZ_MODEL=
